[Unit]
Description=xNetVN Server Monitor Daemon
Documentation=https://github.com/xntmkt/servers
After=network.target

[Service]
Type=simple
NotifyAccess=main
User=root
Group=root
EnvironmentFile=-/etc/xnetvn_monitord/xnetvn_monitord.env
WorkingDirectory=/opt/xnetvn_monitord
ExecStart=/opt/xnetvn_monitord/.venv/bin/python -m xnetvn_monitord.daemon /opt/xnetvn_monitord/config/main.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xnetvn_monitord

# Security settings
PrivateTmp=true
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=false

# Scheduling priority so monitoring and recovery stay responsive under load.
Nice=-10
OOMScoreAdjust=-900
IOSchedulingClass=best-effort
IOSchedulingPriority=0
CPUWeight=10000
IOWeight=10000

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
